#!/bin/bash
# Copy stdin to the clipboard.
#   macOS          -> pbcopy
#   Linux with X   -> xclip
#   headless/SSH   -> tmux buffer + OSC 52 (tmux forwards it to the local terminal),
#                     or raw OSC 52 to the terminal when not inside tmux

if [[ "$OSTYPE" == darwin* ]]; then
  exec pbcopy
elif [[ -n "${DISPLAY// }" ]] && command -v xclip >/dev/null; then
  exec xclip -selection clipboard
elif [[ -n "$TMUX" ]]; then
  exec tmux load-buffer -w -
else
  printf '\e]52;c;%s\a' "$(base64 | tr -d '\n')" > /dev/tty
fi
